+        "minus_view_alias": dict(fuse_q_qr_dequant=True, alias_qli_views=False, device_topk_guard=True),
+        "minus_device_guard": dict(fuse_q_qr_dequant=True, alias_qli_views=True, device_topk_guard=False),
+    }
