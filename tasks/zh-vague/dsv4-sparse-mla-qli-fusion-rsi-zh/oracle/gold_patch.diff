+def run_ablation_suite() -> dict[str, dict[str, Any]]:
+    """Run full_candidate and the three leave-one-out arms required by L4 mutator."""
+    torch.manual_seed(0)
+    t_len, n_heads, q_lora_rank = 4, 16, 128
+    nope_dim, rope_dim, index_dim = 512, 64, 128
+    topk, compress_ratio, padded_capacity = 8, 4, 128
+
+    qr_i8 = torch.randint(-32, 32, (t_len, q_lora_rank), dtype=torch.int8)
+    qr_scale = torch.full((t_len,), 0.05, dtype=torch.float32)
+    rms_weight = torch.ones((q_lora_rank,), dtype=torch.float32)
+    w_q_absorbed = torch.randn((n_heads * (nope_dim + rope_dim), q_lora_rank), dtype=torch.float32) * 0.02
+    cos = torch.ones((t_len, rope_dim), dtype=torch.float32)
+    sin = torch.zeros((t_len, rope_dim), dtype=torch.float32)
+    k_idx_cache = torch.randn((32, 16, n_heads, index_dim), dtype=torch.float32)
+    k_cache = torch.randn((32, 16, n_heads, nope_dim + rope_dim), dtype=torch.float32)
+    v_cache = torch.randn((32, 16, n_heads, nope_dim), dtype=torch.float32)
+    weights = torch.ones((n_heads,), dtype=torch.float32)
+    q_scale = torch.ones((t_len,), dtype=torch.float32)
+    k_scale = torch.ones((32,), dtype=torch.float32)
+    block_table = torch.zeros((t_len, topk), dtype=torch.int32)
+    topk_slots = torch.arange(topk, dtype=torch.int64).unsqueeze(0).expand(t_len, topk)
+    query_start_loc = torch.arange(0, t_len + 1, dtype=torch.int32)
+    # Include a request with seqused_k=12 (< topk * compress_ratio = 32) so topk_indices tail has -1
+    seqused_k = torch.tensor([32, 12, 32, 16], dtype=torch.int32)
+
+    common_kwargs = dict(
+        n_heads=n_heads,
+        nope_dim=nope_dim,
+        rope_dim=rope_dim,
+        index_dim=index_dim,
+        topk=topk,
+        compress_ratio=compress_ratio,
+        padded_capacity=padded_capacity,
+    )
+
+    ref_out, full_metrics = sparse_mla_decode_step(
+        qr_i8, qr_scale, rms_weight, w_q_absorbed, cos, sin,
