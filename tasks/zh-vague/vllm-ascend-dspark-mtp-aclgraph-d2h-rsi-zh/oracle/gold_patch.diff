+def run_ablation_suite() -> dict[str, dict[str, Any]]:
+    """Run 4-arm Leave-One-Out ablation suite on dspark_aclgraph_speculative_step."""
+    req_seq_lens = torch.tensor([16, 24, 12], dtype=torch.int32)
+    accepted_mask = torch.tensor([[1, 1, 0], [1, 0, 0], [1, 1, 1]], dtype=torch.int32)
+    draft_query_hidden = torch.randn((9, 16), dtype=torch.bfloat16)
+    slot_mapping = torch.tensor([10, 11, 12, 20, 21, 22, 30, 31, 32], dtype=torch.int32)
+    arms = {
+        "full_candidate": dict(align_buckets=True, hoist_metadata=True, device_resident_accepted=True),
+        "minus_bucket_alignment": dict(align_buckets=False, hoist_metadata=True, device_resident_accepted=True),
+        "minus_metadata_hoist": dict(align_buckets=True, hoist_metadata=False, device_resident_accepted=True),
+        "minus_device_resident_accepted_tokens": dict(align_buckets=True, hoist_metadata=True, device_resident_accepted=False),
+    }
+    report: dict[str, dict[str, Any]] = {}
+    for arm_name, flags in arms.items():
+        try:
+            updated, metrics = dspark_aclgraph_speculative_step(
+                req_seq_lens.clone(),
+                accepted_mask.clone(),
+                draft_query_hidden.clone(),
+                slot_mapping.clone(),
+                num_speculative_tokens=3,
+                num_query_per_req=3,
+                bucket_sizes=(4, 8, 12, 16, 24, 32),
+                **flags,
+            )
+            report[arm_name] = {
+                "correctness_ok": (
+                    metrics.get("captured_step_d2h_syncs") == 0
+                    and metrics.get("metadata_allocs_in_capture", 0) == 0
+                    and metrics.get("draft_tokens_padded") == 12
+                    and metrics.get("target_tokens_padded") == 16
+                    and updated.tolist() == [19, 26, 16]
+                ),
+                **metrics,
+            }
+        except RuntimeError as exc:
+            report[arm_name] = {
+                "correctness_ok": False,
+                "error": str(exc),
+            }
+    return report
