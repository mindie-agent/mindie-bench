+def _filter_logits_top_k_top_p(
+    logits: torch.Tensor,
+    k: torch.Tensor | None,
+    p: torch.Tensor | None,
+) -> torch.Tensor:
+    width = logits.size(1)
+    if k is not None:
+        probs = logits.softmax(dim=-1, dtype=torch.float32)
+        probs_sort, _ = probs.sort(dim=-1, descending=False)
+        k_long = k.to(device=logits.device, dtype=torch.long)
+        no_top_k_mask = (k_long <= 0) | (k_long >= width)
+        safe_k = torch.where(no_top_k_mask, torch.full_like(k_long, width), k_long).clamp(min=1, max=width)
+        top_k_count = (width - safe_k).unsqueeze(1)
+        top_k_cutoff = probs_sort.gather(-1, top_k_count)
+        top_k_cutoff.masked_fill_(no_top_k_mask.unsqueeze(1), -float("inf"))
+        elements_to_discard = probs < top_k_cutoff
+        logits.masked_fill_(elements_to_discard, -float("inf"))
+
+    if p is not None:
+        probs = logits.softmax(dim=-1, dtype=torch.float32)
+        probs_sort, _ = probs.sort(dim=-1, descending=False)
+        p_fp = p.to(device=logits.device, dtype=probs_sort.dtype)
+        no_top_p_mask = (p_fp <= 0.0) | (p_fp >= 1.0)
+        safe_p = torch.where(no_top_p_mask, torch.ones_like(p_fp), p_fp)
+        cumprob = torch.cumsum(probs_sort, dim=-1)
+        top_p_mask = cumprob <= (1.0 - safe_p.unsqueeze(1))
+        top_p_mask[:, -1] = False  # Always retain at least the highest-probability token
+        top_p_count = top_p_mask.sum(dim=-1, keepdim=True)
+        top_p_cutoff = probs_sort.gather(-1, top_p_count)
+        top_p_cutoff.masked_fill_(no_top_p_mask.unsqueeze(1), -float("inf"))
+        elements_to_discard = probs < top_p_cutoff
+        logits.masked_fill_(elements_to_discard, -float("inf"))
+
+    return logits
+
+
