+def _select_sibling_priority_from_pool(pool: list[int], num_devices: int, chips_per_card: int) -> list[int]:
+    cards: dict[int, list[int]] = {}
+    for pid in sorted(pool):
+        card_id = pid // chips_per_card
+        cards.setdefault(card_id, []).append(pid)
+
+    full_cards = [dies for _, dies in sorted(cards.items()) if len(dies) == chips_per_card]
+    partial_cards = [dies for _, dies in sorted(cards.items()) if len(dies) < chips_per_card]
+
+    chosen: list[int] = []
+    used_full_idx = 0
+    while used_full_idx < len(full_cards) and len(chosen) + chips_per_card <= num_devices:
+        chosen.extend(full_cards[used_full_idx])
+        used_full_idx += 1
+
+    if len(chosen) < num_devices:
+        for dies in partial_cards:
+            for pid in dies:
+                if len(chosen) < num_devices:
+                    chosen.append(pid)
+        for idx in range(used_full_idx, len(full_cards)):
+            for pid in full_cards[idx]:
+                if len(chosen) < num_devices:
+                    chosen.append(pid)
+
+    return sorted(chosen[:num_devices])
+
