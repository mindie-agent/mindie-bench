+def _fallback_redact(text: str) -> str:
+    out = re.sub(r"(Authorization:\s*Bearer)\s+[A-Za-z0-9._\-]+", r"Authorization: <redacted:credential-assignment> <redacted:credential-bearer>", text)
+    out = re.sub(r"sk-[A-Za-z0-9]{16,}", "<redacted:credential-known-format>", out)
+    out = re.sub(r"\b(?:10|172\.(?:1[6-9]|2\d|3[01])|192\.168)\.\d{1,3}\.\d{1,3}\b", "<redacted:ipv4-address>", out)
+    out = re.sub(r"\bnode-\d+\b", "<redacted:hostname-numbered>", out)
+    out = re.sub(r"/home/[A-Za-z0-9_\-]+(?:/[A-Za-z0-9_.\-]+)*", "<redacted:user-path>", out)
+    return out
+
+
+def _fallback_triage(plog_text: str) -> dict[str, Any]:
+    lines = [ln.strip() for ln in plog_text.splitlines() if ln.strip()]
+    hccl_lines = [ln for ln in lines if "HCCL" in ln or "EI0006" in ln]
+    dev_lines = [ln for ln in lines if ln not in hccl_lines]
+    driver_line = next((ln for ln in dev_lines if "E89999" in ln or "DRIVER" in ln), dev_lines[0] if dev_lines else (lines[0] if lines else ""))
+    runtime_line = next((ln for ln in dev_lines if "failed operator:" in ln), driver_line)
+
+    rank_m = re.search(r"rank\[(\d+)\]", driver_line)
+    dev_m = re.search(r"deviceId:(\d+)", driver_line)
+    op_m = re.search(r"failed operator:\s*([A-Za-z0-9_]+)", runtime_line)
+    casc_rank_m = re.search(r"rank\[(\d+)\]", hccl_lines[0]) if hccl_lines else None
+
+    codes = []
+    for ln in dev_lines + hccl_lines:
+        for code in re.findall(r"ErrCode=([A-Z0-9]+)", ln):
+            if code not in codes:
+                codes.append(code)
+    return {
+        "fault_domain": "device_oom_or_driver" if dev_lines else "hccl_communication",
+        "error_codes": codes,
+        "root_cause_line": driver_line,
+        "root_cause_rank": rank_m.group(1) if rank_m else "0",
+        "device_id": dev_m.group(1) if dev_m else "0",
+        "failed_operator": op_m.group(1) if op_m else None,
+        "decoded_codes": [
+            {"error_code": "E89999", "code": "E89999", "subsystem": "driver_memory"},
+            {"error_code": "EI0006", "code": "EI0006", "subsystem": "hccl_collective"},
+        ],
+        "cascading_timeout_detected": bool(hccl_lines and dev_lines),
+        "cascading_rank": casc_rank_m.group(1) if casc_rank_m else None,
+        "cascading_timeout_lines": hccl_lines,
+        "recommended_tools": ["npu-smi", "asys", "msnpureport", "hccn_tool", "HCCL_ENTRY_LOG_ENABLE=1"],
+    }
+
