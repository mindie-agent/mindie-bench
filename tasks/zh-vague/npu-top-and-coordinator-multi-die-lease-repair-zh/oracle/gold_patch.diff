+def _fallback_parse_smi(text: str) -> dict[str, Any]:
+    devices: list[dict[str, Any]] = []
+    processes: list[dict[str, Any]] = []
+    in_proc = False
+    current_card: dict[str, Any] | None = None
+    for raw in text.splitlines():
+        line = raw.strip()
+        if not line.startswith("|") or not line.endswith("|"):
+            continue
+        cells = [c.strip() for c in line.strip("|").split("|")]
+        if any("Process id" in c for c in cells):
+            in_proc = True
+            continue
+        if any(h in cells[0] for h in ("NPU", "Chip", "npu-smi", "No running")):
+            continue
+        if not in_proc and len(cells) == 3:
+            tokens = cells[0].split()
+            if len(tokens) == 2 and tokens[0].isdigit() and not re.match(r"^[0-9A-Fa-f]{4}:", cells[1]):
+                p_toks = cells[2].split()
+                current_card = {
+                    "npu_id": int(tokens[0]),
+                    "name": tokens[1],
+                    "health": cells[1],
+                    "power_w": float(p_toks[0]),
+                    "temperature_c": int(float(p_toks[1])),
+                    "chips": [],
+                    "processes": [],
+                }
+                devices.append(current_card)
+            elif current_card is not None and tokens and tokens[0].isdigit():
+                chip_id = int(tokens[0])
+                phy_id = int(tokens[1]) if len(tokens) > 1 and tokens[1].isdigit() else None
+                m = re.findall(r"(\d+)\s*/\s*(\d+)", cells[2])
+                mem_u, mem_t = (int(m[0][0]), int(m[0][1])) if len(m) >= 1 else (0, 0)
+                hbm_u, hbm_t = (int(m[1][0]), int(m[1][1])) if len(m) >= 2 else (0, 0)
+                aic = int(cells[2].split()[0])
+                chip = {
+                    "chip_id": chip_id,
+                    "bus_id": cells[1],
+                    "aicore_percent": aic,
+                    "memory": {"used_mb": mem_u, "total_mb": mem_t},
+                    "hbm": {"used_mb": hbm_u, "total_mb": hbm_t},
+                }
+                if phy_id is not None:
+                    chip["phy_id"] = phy_id
+                current_card["chips"].append(chip)
+        elif in_proc and len(cells) == 4 and cells[1].isdigit():
+            toks = cells[0].split()
+            npu_id = int(toks[0])
+            chip_id = int(toks[1]) if len(toks) > 1 and toks[1].isdigit() else 0
+            processes.append({
+                "npu_id": npu_id,
+                "chip_id": chip_id,
+                "pid": int(cells[1]),
+                "npu_process_name": cells[2],
+                "npu_memory_mb": int(cells[3]),
+            })
+
+    for dev in devices:
+        chips = dev.pop("chips")
+        dev["bus_id"] = chips[0]["bus_id"]
+        dev["aicore_percent"] = max(c["aicore_percent"] for c in chips)
+        dev["memory"] = {
+            "used_mb": sum(c["memory"]["used_mb"] for c in chips),
+            "total_mb": sum(c["memory"]["total_mb"] for c in chips),
+        }
+        dev["hbm"] = {
+            "used_mb": sum(c["hbm"]["used_mb"] for c in chips),
+            "total_mb": sum(c["hbm"]["total_mb"] for c in chips),
+        }
+        if len(chips) > 1 or "phy_id" in chips[0]:
+            dev["chips"] = chips
+        for proc in processes:
+            if proc["npu_id"] == dev["npu_id"]:
+                p_copy = dict(proc)
+                if "chips" in dev:
+                    for c in dev["chips"]:
+                        if c["chip_id"] == proc["chip_id"] and "phy_id" in c:
+                            p_copy["phy_id"] = c["phy_id"]
+                dev["processes"].append(p_copy)
+    return {"devices": devices, "process_records": processes}
+
