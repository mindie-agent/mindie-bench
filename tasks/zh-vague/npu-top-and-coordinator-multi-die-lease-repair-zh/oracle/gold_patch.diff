+def _build_catalog() -> list[dict[str, Any]]:
+    return [
+        {
+            "runtime_id": f"runtime-{index}",
+            "host": f"host-{index // 4}",
+            "state": "ready",
+            "user": "benchmark",
+            "recipe": "stable",
+            "python_abi": "cp311",
+            "soc": "Ascend910B" if index < 32 else "Ascend910C",
+        }
+        for index in range(64)
+    ]
+
