+def _merge_intervals(intervals: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    if not intervals:
+        return []
+    ordered = sorted(intervals)
+    merged = [ordered[0]]
+    for start, end in ordered[1:]:
+        prev_s, prev_e = merged[-1]
+        if start <= prev_e:
+            merged[-1] = (prev_s, max(prev_e, end))
+        else:
+            merged.append((start, end))
+    return merged
+
+
+def _interval_length(intervals: list[tuple[int, int]]) -> int:
+    return sum(end - start for start, end in _merge_intervals(intervals))
+
+
+def _subtract_intervals(base: list[tuple[int, int]], mask: list[tuple[int, int]]) -> int:
+    merged_base = _merge_intervals(base)
+    merged_mask = _merge_intervals(mask)
+    exposed = 0
+    for b_start, b_end in merged_base:
+        cur = b_start
+        for m_start, m_end in merged_mask:
+            if m_end <= cur:
+                continue
+            if m_start >= b_end:
+                break
+            if m_start > cur:
+                exposed += m_start - cur
+            cur = max(cur, m_end)
+            if cur >= b_end:
+                break
+        if cur < b_end:
+            exposed += b_end - cur
+    return exposed
+
